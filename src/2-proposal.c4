// The intended model.
//
// Written on its own terms. Node titles are shared with the `now` model wherever
// it is the same concept, but nothing here is described by contrast with it.
//
// Three questions, one place answers each, everyone else only reads:
//   1. what is in the code         -> link
//   2. how the code is written out -> lowering
//   3. which file it goes into     -> placement
// ChunkLoadGraph is nobody's answer; it is computed from those three.

model {

  proposed = step 'The intended model' {
    description '
      One direction. The rules write a base placement once; after that the placement
      moves only through changes one judgment accepted. ChunkLoadGraph is computed
      from it and read by every judgment. The one loop is local: the set of accepted
      changes only grows, and it is bounded.
    '

    // ---------------- input ----------------

    p_link = facts 'link facts' {
      description 'Modules, symbol references, side effects, what is included.'
    }

    p_interop = facts '① Interop code position' {
      #moved
      description '
        Where generated glue goes: at the module that imports, or beside the module
        it converts. Decided from the link facts alone.

        It decides who owns a symbol, so it decides what reachability follows.
        It depends on the module graph alone, never on the layout, so it is an input
        to placement. Whether a CommonJS module behind a barrel can be placed
        precisely hangs on this.
      '
    }

    // ---------------- placement ----------------

    p_auto1 = step 'Compute load sets' {
      description '
        Which entries load each module. Shared input to both splitting rules.

        An edge goes to the owner of each referenced binding, resolved through
        re-exports, and to any module whose evaluation has observable side effects.
        It does not follow the importee of every import statement.
        When purity cannot be decided, assume side effects: that is the safe side.

        The same rule answers a build-time question: a re-export module that no
        consumer reaches and that has no side effects never has to be compiled at
        all. That is not a separate optimization, it is this rule used earlier.
      '
    }

    p_entry = writer 'Entry chunks' {
      description '
        One chunk per entry, and the entry is routed to it.

        It claims no module. What it does is create the chunk and register it as the
        target for that entry own load set, so a module only that entry loads lands
        in it later. If a group takes the entry own module, the chunk stays as a
        route that holds no module.
      '
    }

    p_manual = writer 'Manual code splitting' {
      description '
        The modules a group matches go into that group chunk.

        Runs after the runtime is claimed and before the automatic rule, because
        what it claims is only known once its group-level rules are settled: a group under the minimum size is dropped whole and hands its
        modules back, an oversized one splits and re-enters, and per-module filters
        drop members. Those rules read the load sets, so they sit between that step
        and the automatic rule.
      '
    }

    p_auto2 = writer 'Automatic code splitting' {
      description '
        Same load set, same chunk. One rule, applied once.

        Reads whether an entry chunk still holds its own entry module, so it never
        puts anything into a chunk that only forwards.
      '
    }

    p_runtime = writer 'Runtime chunk' {
      description '
        Claims the runtime module before any other rule can.

        Everything may depend on it and it depends on nothing, so while it stays in
        a chunk of its own an edge into it can never close a cycle. That is the
        property the rest of the model leans on, which is why no group rule is
        allowed to take it. Where it finally lives is settled at the end, once
        demand is complete.
      '
    }

    p_placement = state 'BaseChunkPlacement' {
      description '
        Written once, by the rules above, and never written again.

        The finest state anyone gets: every change after this merges or reroutes, so
        an option missing here cannot be recovered. That, not "every module in
        exactly one chunk", is the property that makes it the base. It also decides
        entry routing: which chunk serves each entry, possibly one holding no module.
      '
    }

    p_inline = writer 'inlineCommonChunks' {
      description '
        A common chunk that does not earn a file dissolves into its consumers, and
        every module still evaluates exactly once.

        Not a change to the placement: it is how the working placement is derived
        from the base. That is the whole of the distinction between sitting here and
        sitting inside the base — it is optional, and a base that changes with
        configuration is not a fixed reference for anything. The same defect the
        today row marks at ②, an optional pass upstream of a required one.

        At this position it decides from the base and the load sets, before any load
        graph exists, so the graph is computed once on a placement that is not about
        to dissolve. The cost of that: it coarsens before any judgment has run, and
        the options it drops are ones the merges below can never get back.
      '
    }

    p_current = state 'ChunkPlacement' {
      description '
        The placement as it stands: starts as the base, advances one accepted change
        at a time.

        Two writers, and both are the same judgment. Everything downstream that says
        "the placement" means this one. The base stays beside it, so what a change
        did is the difference between two values rather than a field that was
        overwritten.
      '
    }

    // ---------------- the computed view ----------------

    p_loadgraph = derived '⑤ ChunkLoadGraph' {
      #moved
      description '
        Which file imports which file, computed from ChunkPlacement and the link
        facts. Nobody owns it and nobody may edit it. One definition, read by every
        judgment. Recomputed whenever the placement advances.
      '
    }

    // ---------------- changes to the placement ----------------

    p_check = check 'Judge the change, then apply it' {
      #bounded-loop
      description '
        A change is a value. Judge it against the invariants it can touch — first of
        all the load graph that change implies — then accept or reject. Rejecting is
        the safe direction. The loop stays here: the set of accepted changes only
        grows, and it is bounded.
      '
    }

    p_fold = writer '② avoidRedundantChunkLoads' {
      #moved
      description '
        Proposes a merge: a dynamic entry whose modules every importer already loads
        does not need a chunk of its own.
      '
    }
    p_insert_common = writer 'mergeCommonChunks: shared modules' {
      description 'Proposes a merge: a shared module joins a chunk that already depends on it.'
    }
    p_facade = writer 'mergeCommonChunks: empty facades' {
      description 'Proposes a merge: a chunk that only forwards joins the chunk it forwards to.'
    }

    // ---------------- lowering ----------------

    p_order = step 'Wrapping analysis' {
      #bounded-loop
      description '
        Which modules must become deferred functions so that execution order holds
        for this layout.

        It reasons against source evaluation order inside each chunk: concatenation
        order decides evaluation order inside a file, so the analysis needs a
        definite order to compare with, and that one matches source order by
        construction. Any other order is decided after this, once the wrap set says
        which orderings are still constrained.

        Wrapping is what makes a cycle harmless: a top-level read becomes a call.
        Each round only adds wrappers and the ceiling is every module that can be
        wrapped, so it terminates; how far below that ceiling it stops is policy.
        It changes the wrap set only, never module ownership.
      '
    }

    p_strict_facade = writer 'Give an entry its own trigger file' {
      description '
        Proposes a change to entry routing: when an entry trigger cannot stay inline,
        it moves into a file that holds no module.
      '
    }

    p_resort = step '④ chunkModulesOrder' {
      #moved
      description '
        The final module order inside each chunk: sort by module id within whatever
        ordering constraints are left.

        A derived fact of the sealed placement and the wrap set. It reads which
        modules a chunk holds, so it runs once every placement change has been
        applied; and the content hash is taken over the emitted text, whose order
        this decides, so it runs before the hashes.

        It touches no placement itself. Nothing moves between chunks and the load
        graph does not change, which is why it is not a change for the placement
        judgment to see.

        Which constraints are left is an output of the wrapping analysis, so this
        order satisfies them by construction. Wrapping a module moves its evaluation
        into a call, so its position stops constraining anything except that its
        declaration precede an eager caller; when every caller is wrapped too, the
        constraint disappears. A fully wrapped chunk has no constraints and sorts
        freely; a partly wrapped one sorts within the freedom that is left.
        So wrapping more also compresses better.
      '
    }

    p_runtime_merge = writer '③ Settle where the runtime lives' {
      #moved
      description '
        Proposes the last change: merge the runtime into its only consumer, drop it
        if nothing references it, or leave it standalone.

        Last, because wrapping is what completes the demand for it.
      '
    }

    p_check_late = check 'Judge the change, then apply it' {
      description '
        The same judgment, at the second point where changes appear.

        Neither change it sees can invalidate the wrapping analysis that produced
        them: the trigger file adds a routing chunk and moves no module, and until
        the runtime is merged an edge into it closes no cycle. So there is no round
        after this one.
      '
    }

    // ---------------- output ----------------

    p_seal = step 'Seal' {
      description '
        The placement stops moving. Everything after this reads it; nothing writes it.
      '
    }
    p_derived_facts = step 'Derived facts: names, hashes, execution order' {
      description '
        Computed from the sealed graph, once.

        A chunk name has to be an identity that does not move when its content
        changes, because a consumer downstream depends on exactly that.
      '
    }

    p_import_map = output 'chunkImportMap' {
      description '
        Emits a map from each chunk stable key to its hashed filename, so a chunk
        references its siblings by that key rather than by their hash.

        This is why chunk identity has to be independent of content: one hash
        changing then invalidates one file instead of cascading into every chunk
        that imports it.
      '
    }

    // ---------------- flow ----------------

    p_link -> p_auto1
    p_interop -> p_auto1 'decides who owns a symbol'
    p_auto1 -> p_entry
    p_entry -> p_runtime
    p_runtime -> p_manual 'the runtime is claimed first'
    p_manual -> p_auto2 'then whatever the groups left'
    p_auto2 -> p_placement
    p_placement -> p_inline
    p_inline -> p_current 'the starting value'

    p_current -> p_loadgraph
    p_link -> p_loadgraph 'symbol relationships'

    p_loadgraph -> p_fold 'read to decide what to propose'
    p_loadgraph -> p_insert_common
    p_loadgraph -> p_facade
    p_fold -> p_check 'proposes'
    p_insert_common -> p_check 'proposes'
    p_facade -> p_check 'proposes'
    p_check -[reads]-> p_loadgraph 'judged against the implied graph'
    p_check -[gated]-> p_current 'applied only if accepted'

    p_check -> p_order 'once no change is left to propose'
    p_order -[reads]-> p_loadgraph
    p_order -> p_strict_facade
    p_order -> p_runtime_merge
    p_order -> p_resort 'the ordering constraints that are left'
    p_strict_facade -> p_check_late 'proposes'
    p_runtime_merge -> p_check_late 'proposes'
    p_check_late -[reads]-> p_loadgraph 'judged against the implied graph'
    p_check_late -[gated]-> p_current 'applied only if accepted'
    p_check_late -> p_seal 'once no change is left to propose'
    p_seal -> p_resort
    p_resort -> p_derived_facts
    p_derived_facts -> p_import_map
  }
}
